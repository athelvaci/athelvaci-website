---
import PortalGlyph from './PortalGlyph.astro';
import DimensionSwitcher from './DimensionSwitcher.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const current = (href: string) => (href.startsWith('/#') ? undefined : path.startsWith(href) ? 'page' : undefined);
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="/" aria-label={`${site.title}, home`}>
      <PortalGlyph size={34} />
      <span>{site.title}</span>
    </a>

    <button class="menu-btn" type="button" data-menu-btn aria-expanded="false" aria-controls="site-menu">
      <span class="sr-only">Menu</span>
      <span class="bars" aria-hidden="true"></span>
    </button>

    <nav class="menu" id="site-menu" aria-label="Main">
      <ul class="menu-list">
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} data-section={item.section} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <DimensionSwitcher compact />
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: color-mix(in oklab, var(--paper) 86%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.3);
    backdrop-filter: blur(12px) saturate(1.3);
    border-bottom: 2px solid transparent;
    transition: border-color 0.2s;
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 800;
    font-stretch: 116%;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .menu-list {
    display: flex;
    gap: 1.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .menu-list a {
    padding: 0.25rem 0;
    border-bottom: 3px solid transparent;
    font-weight: 650;
    font-size: 0.97rem;
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .menu-list a:hover {
    border-bottom-color: var(--accent);
  }
  .menu-list a[aria-current] {
    border-bottom-color: var(--ink);
  }
  .menu-btn {
    display: none;
    position: relative;
    width: 2.8rem;
    height: 2.8rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--card);
    cursor: pointer;
  }
  .bars,
  .bars::before {
    position: absolute;
    left: 50%;
    width: 1.1rem;
    height: 2px;
    background: var(--ink);
    transition: transform 0.2s var(--ease-out);
  }
  .bars {
    top: calc(50% + 4px);
    transform: translateX(-50%);
  }
  .bars::before {
    content: '';
    top: -8px;
    left: 0;
    transform: none;
  }
  .nav[data-open] .bars {
    top: 50%;
    transform: translateX(-50%) rotate(-45deg);
  }
  .nav[data-open] .bars::before {
    top: 0;
    transform: rotate(90deg);
  }

  @media (max-width: 900px) {
    .nav {
      --nav-h: 60px;
    }
    .menu-btn {
      display: block;
    }
    .menu {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
      padding: 1.2rem var(--gutter) 1.8rem;
      border-bottom: 2px solid var(--ink);
      background: var(--paper);
    }
    .nav[data-open] .menu {
      display: flex;
    }
    .menu-list {
      flex-direction: column;
      gap: 0.35rem;
    }
    .menu-list a {
      display: inline-block;
      font-size: 1.5rem;
      font-weight: 750;
      font-stretch: 112%;
      letter-spacing: -0.02em;
    }
  }
</style>
