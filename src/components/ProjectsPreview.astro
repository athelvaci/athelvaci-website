---
import { getProjects } from '../lib/content';
import ProjectCard from './ProjectCard.astro';
import ProjectSlot from './ProjectSlot.astro';

const projects = (await getProjects()).slice(0, 3);
---

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <header class="section-head head-row">
      <div class="head-text">
        <h2 id="projects-title">Projects</h2>
        <p>Experiments from the lab.</p>
      </div>
      <a class="link all" href="/projects/">All projects</a>
    </header>

    <div class="grid" style={`--cols: 3; --used: ${projects.length}`}>
      {projects.map((project) => <ProjectCard project={project} />)}
      {projects.length < 3 && <ProjectSlot span={3 - projects.length} />}
    </div>
  </div>
</section>

<style>
  .head-row {
    grid-template-columns: 1fr auto;
    align-items: end;
  }
  .head-text {
    display: grid;
    gap: 0.75rem;
  }
  .head-text p {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--text-l);
  }
  .all {
    font-weight: 700;
    padding-bottom: 0.3rem;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.8rem;
  }
  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 680px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
