---
interface Props {
  size?: number;
  class?: string;
}

const { size = 28, class: className = '' } = Astro.props;

// A real spiral, computed once at build time.
const points: string[] = [];
for (let i = 0; i <= 64; i++) {
  const s = i / 64;
  const angle = s * Math.PI * 2 * 2.6;
  const radius = 1.2 + s * 10;
  points.push(`${(16 + Math.cos(angle) * radius).toFixed(2)} ${(16 + Math.sin(angle) * radius).toFixed(2)}`);
}
const spiral = 'M' + points.join('L');
---

<svg class:list={['glyph', className]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <circle class="glyph-fill" cx="16" cy="16" r="14" />
  <circle class="glyph-band" cx="16" cy="16" r="14" />
  <circle class="glyph-edge" cx="16" cy="16" r="15.2" />
  <path class="glyph-spiral" d={spiral} />
</svg>

<style>
  .glyph {
    flex: none;
    overflow: visible;
  }
  .glyph-fill {
    fill: var(--panel);
  }
  .glyph-band {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.6;
  }
  .glyph-edge {
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.2;
  }
  .glyph-spiral {
    fill: none;
    stroke: var(--mark);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    transform-origin: 16px 16px;
    transition: transform 0.7s var(--ease-out);
  }
  :global(a:hover) .glyph-spiral,
  :global(.stop:hover) .glyph-spiral {
    transform: rotate(200deg);
  }
</style>
