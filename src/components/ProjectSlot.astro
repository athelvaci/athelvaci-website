---
import { site } from '../data/site';

interface Props {
  /** How many grid columns the slot should fill. */
  span?: number;
  level?: 2 | 3;
}

const { span = 1, level = 3 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<article class="slot" style={`--span: ${span}`}>
  <Heading class="title">More projects are on the way</Heading>
  <p>Most of my experiments live on GitHub until they earn a page here.</p>
  <a class="btn btn--ghost" href={site.social.github} rel="me noopener">Browse GitHub</a>
</article>

<style>
  .slot {
    grid-column: span var(--span, 1);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0.9rem;
    min-height: 16rem;
    padding: 1.6rem 1.8rem;
    border: 2px dashed var(--ink);
    border-radius: var(--radius-l);
  }
  .title {
    font-size: 1.4rem;
  }
  p {
    margin: 0;
    color: var(--ink-soft);
  }

  @media (max-width: 1000px) {
    .slot {
      grid-column: 1 / -1;
    }
  }
</style>
