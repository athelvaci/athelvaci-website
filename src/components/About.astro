---
import { about } from '../data/about';

const signLabel: Record<string, string> = { '+': 'Added: ', '-': 'Removed: ', '=': 'Unchanged: ' };
const screen = [
  ...about.series.map((item) => ({ ...item, kind: 'Series' })),
  ...about.films.map((item) => ({ ...item, kind: 'Film' })),
];
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container about-top">
    <header class="about-head">
      <h2 id="about-title">About me</h2>
      <blockquote class="about-quote">
        <p>{about.quote}</p>
      </blockquote>
    </header>

    <div class="about-copy">
      {about.paragraphs.map((text) => <p>{text}</p>)}
      <p>
        <a class="link" href="/projects/">Poke around the projects</a>, <a class="link" href="/blog/">read the blog</a>
        or <a class="link" href="#contact">just say hi</a>.
      </p>
    </div>
  </div>

  <div class="container about-more">
    <figure class="patch">
      <figcaption>
        <span class="patch-title">Patch notes</span>
        <span class="patch-ver">v2020 to v2026</span>
      </figcaption>
      <ul class="patch-list">
        {
          about.patchNotes.map((note) => (
            <li data-sign={note.sign}>
              <span class="sign" aria-hidden="true">
                {note.sign}
              </span>
              <span class="sr-only">{signLabel[note.sign]}</span>
              <span>{note.text}</span>
            </li>
          ))
        }
      </ul>
    </figure>

    <div class="shelves">
      <section class="shelf" aria-labelledby="shelf-books">
        <h3 id="shelf-books">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v15H5.5C4.7 19 4 18.3 4 17.5v-12z" />
            <path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v15h5.5c.8 0 1.5-.7 1.5-1.5v-12z" />
          </svg>
          On my shelf
        </h3>
        <ul class="list">
          {
            about.books.map((book) => (
              <li>
                <a class="link" href={book.href} rel="noopener">
                  {book.title}
                </a>
                <span class="by">{book.by}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="shelf" aria-labelledby="shelf-screen">
        <h3 id="shelf-screen">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <rect x="3" y="5" width="18" height="12" rx="2" />
            <path d="M8 21h8M12 17v4" />
          </svg>
          On my screen
        </h3>
        <ul class="list">
          {
            screen.map((item) => (
              <li>
                <a class="link" href={item.href} rel="noopener">
                  {item.title}
                </a>
                <span class="by">{item.kind}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="shelf" aria-labelledby="shelf-away">
        <h3 id="shelf-away">
          <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
            <circle cx="6" cy="16" r="3.6" />
            <circle cx="18" cy="16" r="3.6" />
            <path d="M6 16l4.2-8H15l3 8M10.2 8l2.8 8M9 6h3" />
          </svg>
          Away from the keyboard
        </h3>
        <ul class="tags">
          {about.away.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    </div>
  </div>
</section>

<style>
  /* The opening of this section comes out of the hero portal (scripts/feast.ts); the rest fades in once it has landed. */
  .about-more {
    opacity: var(--emerge, 1);
  }
  .about-top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
  }
  .about-head {
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
    display: grid;
    gap: 1.8rem;
  }
  .about-quote {
    margin: 0;
    padding-left: 1.2rem;
    border-left: 6px solid var(--accent);
  }
  .about-quote p {
    margin: 0;
    font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.3rem);
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.14;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .about-copy {
    font-size: clamp(1.1rem, 1.02rem + 0.45vw, 1.32rem);
    line-height: 1.58;
  }
  .about-copy p {
    max-width: 58ch;
    margin-bottom: 1.1em;
  }

  .about-more {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 5.5rem);
    align-items: start;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .patch {
    margin: 0;
    padding: 1.3rem 1.4rem 1.4rem;
    border: 2px solid var(--ink);
    border-radius: var(--radius-m);
    background: var(--panel);
    color: var(--on-panel);
    box-shadow: 6px 6px 0 var(--shadow-c);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.5;
  }
  .patch figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    margin-bottom: 1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px dashed color-mix(in oklab, var(--on-panel) 35%, transparent);
  }
  .patch-title {
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 800;
    font-stretch: 112%;
  }
  .patch-ver {
    opacity: 0.7;
  }
  .patch-list {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .patch-list li {
    display: grid;
    grid-template-columns: 1.2rem 1fr;
    gap: 0.4rem;
  }
  .sign {
    font-weight: 700;
  }
  .patch-list li[data-sign='+'] .sign {
    color: var(--panel-accent);
  }
  .patch-list li[data-sign='-'] .sign {
    color: var(--panel-pop);
  }
  .patch-list li[data-sign='-'] span:last-child {
    text-decoration: line-through;
    text-decoration-color: var(--panel-pop);
    opacity: 0.75;
  }
  .patch-list li[data-sign='='] {
    opacity: 0.75;
  }

  .shelves {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem 1.6rem;
  }
  .shelf h3 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 1rem;
    font-size: 1.1rem;
    line-height: 1.2;
  }
  .shelf svg {
    flex: none;
    fill: none;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .list {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .list li {
    display: grid;
    line-height: 1.3;
  }
  .by {
    color: var(--ink-soft);
    font-size: 0.88rem;
  }

  @media (max-width: 1080px) {
    .shelves {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .about-top,
    .about-more {
      grid-template-columns: 1fr;
    }
    .about-head {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .shelves {
      grid-template-columns: 1fr;
    }
  }
</style>
